// Integration-style test: send a kind-4 (NIP-04) DM to a mock relay and expect OK
import { describe, it, beforeAll, afterAll, expect } from "vitest";
import { WebSocketServer, WebSocket } from "ws";
import {
  finalizeEvent,
  getPublicKey,
  generateSecretKey,
  nip04,
} from "nostr-tools";

function createMockRelay() {
  const wss = new WebSocketServer({ port: 0 }); // random free port
  let lastEvent = null;

  wss.on("connection", (ws) => {
    ws.on("message", (raw) => {
      try {
        const msg = JSON.parse(raw.toString());
        if (Array.isArray(msg) && msg[0] === "EVENT" && msg[1]) {
          lastEvent = msg[1];
          // Respond with OK per Nostr relay protocol
          ws.send(JSON.stringify(["OK", lastEvent.id || "", true, ""]));
        }
      } catch (e) {
        // ignore parse errors in test
      }
    });
  });

  return {
    wss,
    get url() {
      const address = wss.address();
      return `ws://127.0.0.1:${address.port}`;
    },
    get lastEvent() {
      return lastEvent;
    },
  };
}

describe.skip("Nostr kind-4 DM publish", () => {
  let relay;

  beforeAll(() => {
    relay = createMockRelay();
  });

  afterAll(async () => {
    await new Promise((resolve) => relay.wss.close(() => resolve(true)));
  });

  it("publishes a kind-4 event and receives OK from relay", async () => {
    const sk = generateSecretKey();
    const pk = getPublicKey(sk);
    const content = await nip04.encrypt(
      sk,
      pk,
      "kind4 test " + new Date().toISOString()
    );

    const dmEvent = finalizeEvent(
      {
        kind: 4,
        created_at: Math.floor(Date.now() / 1000),
        tags: [["p", pk]],
        content,
        pubkey: pk,
      },
      sk
    );

    const ws = new WebSocket(relay.url);

    const result = await new Promise((resolve, reject) => {
      const timeout = setTimeout(() => reject(new Error("timeout")), 5000);
      ws.on("open", () => {
        ws.send(JSON.stringify(["EVENT", dmEvent]));
      });
      ws.on("message", (data) => {
        const msg = data.toString();
        if (msg.startsWith('["OK"')) {
          clearTimeout(timeout);
          resolve({ ok: true, msg });
          ws.close();
        }
      });
      ws.on("error", (err) => {
        clearTimeout(timeout);
        reject(err);
      });
    });

    expect(result.ok).toBe(true);
    expect(relay.lastEvent).toBeTruthy();
    expect(relay.lastEvent.kind).toBe(4);
    expect(relay.lastEvent.tags).toEqual([["p", pk]]);
    expect(typeof relay.lastEvent.content).toBe("string");
  });
});
